/* ═══════════════════════════════════════════════════════════
   PRO / SOBER OVERRIDE  —  senior UI pass
   Goal: kill the "AI-generated" tells (rainbow text everywhere,
   permanent glows/blinks, decorative blobs) WITHOUT changing
   content, layout, palette identity, or functionality.
   Everything below only overrides visual polish.
   ═══════════════════════════════════════════════════════════ */

/* 1) Gradient text is now an ACCENT, not the default.
      Numbers, section-title <em>, prices, quality names -> solid.
      Keep gradient only on brand identity marks + one H1 word. */
.stat-n,
.trust-item-num,
.vs-banner-num,
.vs-metric-val,
.plan-price-amount,
.mprice-main,
.qs2-title em,
.pricing-title em,
.quicknav-title em,
.faq-title em,
.rs2-title span,
.qc-fhd .qc-name,
.qc-4k .qc-name,
.qc-8k .qc-name{
  background:none !important;
  -webkit-background-clip:border-box !important;
  background-clip:border-box !important;
  color:var(--text) !important;
}
/* section-title emphasis: quiet cyan instead of rainbow */
.qs2-title em,.pricing-title em,.quicknav-title em,.faq-title em,.rs2-title span{
  color:var(--cyan) !important;
}
/* quality tier names keep their single hue (already colored via .qc-*-name base) */
.qc-fhd .qc-name{color:#9B7CFF !important;}
.qc-4k .qc-name{color:#E064C0 !important;}
.qc-8k .qc-name{color:var(--cyan) !important;}

/* 2) Turn OFF permanent/idle animations (keep hover + one-shot entrances). */
.h-badge-dot,.live-dot,.rs2-overline-dot,.pricing-eyebrow-dot,
.quicknav-dot,.faq-dot,.timer-pulse,.htl-tag-dot{
  animation:none !important;
}
.qc-icon-wrap{animation:none !important;}
.qc-glow-ring,.htl-glow{display:none !important;}
.pricing-timer.urgent{animation:none !important;}

/* 3) Remove decorative blobs that add nothing. */
.orb,.orb-1,.orb-2{display:none !important;}
.hero-glow{opacity:.45 !important;}

/* 4) Calm shadows: softer, less "floating neon". */
.btn-primary{box-shadow:0 6px 18px rgba(123,92,255,.20) !important;}
.plan-card.popular{box-shadow:0 0 0 1px rgba(240,64,200,.14),0 10px 30px rgba(0,0,0,.28) !important;}
.stat:hover,.plan-card:hover,.qn-card:hover,.device-card:hover{
  box-shadow:0 12px 28px rgba(0,0,0,.30) !important;
}

/* 5) Typography polish: tighter, more editorial, less "hero-giant". */
.h-title{letter-spacing:-.02em;line-height:1.02;}
.qs2-title,.pricing-title,.quicknav-title,.faq-title{letter-spacing:-.01em;}
.h-sub,.pricing-sub,.quicknav-sub,.faq-sub{color:#a7a3bd;}
.stat-l,.trust-item-lbl,.qc-sub{letter-spacing:.06em;}

/* 6) Buttons: consistent, identifiable, not oversized. */
.btn{height:46px;}
.nv-btn-order{box-shadow:none;}
.nv-btn-order:hover{filter:brightness(1.06);}

/* 7) Cleaner focus states for keyboard users (a11y). */
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,.faq-q:focus-visible{
  outline:2px solid var(--cyan);
  outline-offset:2px;
  border-radius:6px;
}

/* 8) Guard against accidental horizontal scroll on mobile. */
html,body{max-width:100%;overflow-x:hidden;}

/* 9) Respect reduced-motion preference. */
@media(prefers-reduced-motion:reduce){
  *{animation:none !important;transition:none !important;}
  .hero-fluid{display:none !important;}
}

