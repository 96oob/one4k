    let config = {
        SIM_RESOLUTION: 200,
        DYE_RESOLUTION: 512,
        DENSITY_DISSIPATION: 0.958, // trails fade so idle swirls stay dynamic, not saturated
        VELOCITY_DISSIPATION: 0.96,
        PRESSURE_DISSIPATION: 0.8,
