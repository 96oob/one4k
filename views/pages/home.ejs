.trust-pill{display:inline-flex;align-items:center;gap:7px;font-size:.82rem;color:var(--soft);padding:6px 13px;border-radius:var(--r-pill);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07)}
.ci-g{color:#34d399}.ci-b{color:#60a5fa}.ci-p{color:#f472b6}.ci-c{color:#22d3ee}
.h-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;opacity:0;animation:up .55s .46s var(--ease) forwards}
.stat{padding:16px 14px;border-radius:var(--r-lg);background:var(--surface);border:1px solid var(--border);backdrop-filter:blur(16px);transition:all .28s var(--ease);position:relative;overflow:hidden}
.stat::before{content:"";position:absolute;inset:0;background:var(--grad-soft);opacity:0;transition:opacity .28s ease}
.stat:hover{transform:translateY(-4px);border-color:var(--border-hi)}
.stat:hover::before{opacity:1}
.stat-n{font-family:'Oswald',sans-serif;font-size:1.9rem;font-weight:700;line-height:1;margin-bottom:6px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;position:relative}
.stat-l{font-size:.68rem;font-weight:500;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);position:relative}
/* Hero right */
.hero-right{position:relative;opacity:0;animation:fadeIn .7s .22s var(--ease) forwards}
.orb{position:absolute;border-radius:50%;filter:blur(36px);pointer-events:none;z-index:0}
.orb-1{width:250px;height:250px;bottom:-8%;left:-10%;background:radial-gradient(circle,rgba(64,207,255,.18),transparent 65%)}
.orb-2{width:240px;height:240px;top:-10%;right:-6%;background:radial-gradient(circle,rgba(240,64,200,.16),transparent 65%)}
.v-card{position:relative;z-index:1;border-radius:var(--r-xl);border:1px solid var(--border-hi);background:linear-gradient(160deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:0 40px 90px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.04);padding:3px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.v-screen{border-radius:calc(var(--r-xl) - 3px);background:linear-gradient(160deg,#0E1128,#10132E 55%,#130E2E);border:1px solid rgba(255,255,255,.05);overflow:hidden}
.vs-head{padding:18px 20px 0;display:flex;align-items:center;justify-content:space-between}
.vs-brand{display:flex;align-items:center;gap:11px}
.vs-logo{width:40px;height:40px;border-radius:12px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:.85rem;box-shadow:0 6px 20px rgba(123,92,255,.30);flex-shrink:0}
.vs-brand-name{font-family:'Oswald',sans-serif;font-size:1rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#fff}
.vs-brand-sub{font-size:.70rem;color:var(--muted);margin-top:2px}
.live-tag{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:var(--r-pill);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);font-size:.68rem;font-weight:500;color:#a0f0c8;letter-spacing:.04em}
.live-dot{width:6px;height:6px;border-radius:50%;background:#34d399;box-shadow:0 0 7px #34d399;animation:blink 2s infinite}
.vs-sep{height:1px;background:rgba(255,255,255,.055);margin:16px 20px}
.vs-banner{margin:0 20px;border-radius:16px;background:linear-gradient(130deg,rgba(64,207,255,.10),rgba(123,92,255,.14) 50%,rgba(240,64,200,.10));border:1px solid rgba(255,255,255,.07);padding:20px;display:flex;align-items:flex-end;justify-content:space-between;gap:12px;min-height:140px;position:relative;overflow:hidden}
.vs-banner-glow{position:absolute;top:-30%;right:-5%;width:180px;height:180px;background:radial-gradient(circle,rgba(240,64,200,.22),transparent 60%);filter:blur(20px)}
.vs-banner-left{position:relative;z-index:1}
.vs-banner-title{font-family:'Oswald',sans-serif;font-size:1.5rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:#fff;line-height:1.1;margin-bottom:9px}
.vs-banner-tags{display:flex;flex-wrap:wrap;gap:6px}
.vs-tag{padding:4px 10px;border-radius:var(--r-pill);background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.07);font-size:.66rem;font-weight:500;letter-spacing:.04em;color:#e8e4ff}
.vs-banner-right{flex-shrink:0;position:relative;z-index:1;text-align:right}
.vs-banner-num{font-family:'Oswald',sans-serif;font-size:2.3rem;font-weight:700;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1}
.vs-banner-numlabel{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-top:3px}
.vs-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;padding:12px 20px}
.vs-metric{padding:12px;border-radius:var(--r-md);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.055)}
.vs-metric-val{font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:600;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:3px;letter-spacing:.02em}
.vs-metric-lbl{font-size:.63rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.vs-channels{padding:0 20px 20px;display:flex;flex-direction:column;gap:8px}
.vs-ch{display:flex;align-items:center;gap:11px}
.vs-ch-icon{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;font-size:.85rem;flex-shrink:0}
.ch-sp{background:linear-gradient(135deg,#2563eb,#4f46e5)}.ch-mv{background:linear-gradient(135deg,#7c3aed,#db2777)}.ch-nw{background:linear-gradient(135deg,#0891b2,#1d4ed8)}
.vs-ch-info{flex:1}
.vs-ch-name{font-size:.74rem;font-weight:500;color:var(--soft);margin-bottom:4px}
.vs-ch-bar{height:3px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden}
.vs-ch-fill{height:100%;border-radius:3px;background:var(--grad)}
.vs-ch-count{font-size:.70rem;font-weight:600;color:var(--muted);white-space:nowrap;font-family:'Oswald',sans-serif}
/* Floating cards */
.fc{position:absolute;z-index:10;display:flex;align-items:center;gap:10px;padding:11px 15px;border-radius:16px;backdrop-filter:blur(20px);background:rgba(8,12,26,.88);box-shadow:0 20px 50px rgba(0,0,0,.38)}
.fc-tr{top:-20px;right:16px;border:1px solid rgba(123,92,255,.30)}
.fc-bl{bottom:-18px;left:10px;border:1px solid rgba(64,207,255,.28)}
.fc-icon{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;font-size:.78rem;flex-shrink:0}
.fc-icon-c{background:rgba(64,207,255,.12);border:1px solid rgba(64,207,255,.20);color:var(--cyan)}
.fc-title{font-size:.78rem;font-weight:600;color:#fff;line-height:1.3}
.fc-sub{font-size:.67rem;color:var(--muted);margin-top:2px}
.fc-avatars{display:flex}
.fc-av{width:24px;height:24px;border-radius:50%;border:2px solid rgba(8,12,26,.9);display:grid;place-items:center;font-size:.54rem;font-weight:700;color:#fff}
.fc-av:not(:first-child){margin-left:-6px}
.av-a{background:linear-gradient(135deg,#40CFFF,#557EFF)}.av-b{background:linear-gradient(135deg,#7B5CFF,#F040C8)}.av-c{background:linear-gradient(135deg,#F040C8,#FF4F82)}
/* Hero T logo */
.hero-t-logo{display:flex;align-items:center;gap:16px;margin-bottom:22px;opacity:0;animation:up .55s .16s var(--ease) forwards}
.htl-inner{position:relative;flex-shrink:0}
.htl-icon{width:60px;height:60px;border-radius:17px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:1.35rem;flex-shrink:0;box-shadow:0 8px 24px rgba(123,92,255,.35);position:relative;z-index:1;transition:filter .4s ease}
.htl-svg-wrap{
  width:68px;height:68px;
  flex-shrink:0;position:relative;z-index:1;
  display:flex;align-items:center;justify-content:center;
  filter:drop-shadow(0 8px 22px rgba(180,40,220,.50));
  transition:filter .4s ease;
}
.htl-inner:hover .htl-svg-wrap{
  filter:drop-shadow(0 12px 32px rgba(240,64,200,.65));
}
.htl-svg-wrap{
  width:64px;height:64px;border-radius:18px;
  background:#0a0a0a;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;position:relative;z-index:1;
  box-shadow:0 8px 28px rgba(123,92,255,.40),0 0 0 1px rgba(255,255,255,.07);
  transition:transform .4s ease,box-shadow .4s ease;
  overflow:hidden;
}
.htl-svg-wrap:hover{transform:scale(1.06);box-shadow:0 12px 36px rgba(240,64,200,.45)}
.htl-svg-wrap svg{display:block;width:54px;height:54px}
.htl-glow{position:absolute;inset:-8px;border-radius:24px;background:radial-gradient(circle,rgba(240,64,200,.25),rgba(123,92,255,.15),transparent 65%);filter:blur(10px);z-index:0;animation:htlGlow 3s ease-in-out infinite}
.htl-tagline{display:flex;align-items:center;gap:7px;font-family:'Oswald',sans-serif;font-size:.75rem;font-weight:500;letter-spacing:.10em;text-transform:uppercase;color:var(--muted)}
.htl-tag-dot{width:5px;height:5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 6px var(--cyan);flex-shrink:0;animation:blink 2.2s infinite}

/* ═══ QUALITY STRIP ═══ */
.section-bottom{width:100%;background:linear-gradient(180deg,rgba(8,12,26,0),rgba(13,17,40,.7));border-top:1px solid rgba(255,255,255,.055)}
.qs2{width:100%;padding:60px 5%;position:relative;overflow:hidden}
.qs2::before{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:700px;height:280px;background:radial-gradient(ellipse,rgba(123,92,255,.10),rgba(240,64,200,.06),transparent 70%);filter:blur(50px)}
.qs2-inner{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.qs2-header{text-align:center;margin-bottom:44px}
.qs2-eyebrow{display:inline-flex;align-items:center;gap:10px;font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.qs2-eyebrow span{display:block;width:28px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.22))}
.qs2-eyebrow span:last-child{background:linear-gradient(90deg,rgba(255,255,255,.22),transparent)}
.qs2-title{font-family:'Oswald',sans-serif;font-size:clamp(1.4rem,2.8vw,2.1rem);font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:#fff;line-height:1}
.qs2-title em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.qs2-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.qc{position:relative;border-radius:22px;padding:26px 14px 20px;display:flex;flex-direction:column;align-items:center;gap:14px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);transition:all .4s var(--ease);overflow:hidden}
.qc::before{content:"";position:absolute;top:-60%;left:-60%;width:60%;height:220%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.07),transparent);transform:skewX(-15deg) translateX(-100%);transition:none}
.qc:hover::before{transform:skewX(-15deg) translateX(500%);transition:transform .65s ease}
.qc::after{content:"";position:absolute;bottom:0;left:10%;right:10%;height:1px;opacity:0;transition:opacity .4s}
.qc:hover{transform:translateY(-7px)}.qc:hover::after{opacity:1}
.qc-sd:hover{background:rgba(85,126,255,.07);border-color:rgba(85,126,255,.28);box-shadow:0 22px 46px rgba(85,126,255,.14)}
.qc-sd::after{background:linear-gradient(90deg,transparent,rgba(85,126,255,.6),transparent)}
.qc-hd:hover{background:rgba(64,207,255,.07);border-color:rgba(64,207,255,.28);box-shadow:0 22px 46px rgba(64,207,255,.14)}
.qc-hd::after{background:linear-gradient(90deg,transparent,rgba(64,207,255,.6),transparent)}
.qc-fhd:hover{background:rgba(123,92,255,.07);border-color:rgba(123,92,255,.28);box-shadow:0 22px 46px rgba(123,92,255,.14)}
.qc-fhd::after{background:linear-gradient(90deg,transparent,rgba(123,92,255,.6),transparent)}
.qc-4k{background:linear-gradient(160deg,rgba(240,64,200,.09),rgba(123,92,255,.07));border-color:rgba(240,64,200,.20)}
.qc-4k:hover{background:linear-gradient(160deg,rgba(240,64,200,.14),rgba(123,92,255,.10));border-color:rgba(240,64,200,.40);box-shadow:0 26px 52px rgba(240,64,200,.18)}
.qc-4k::after{background:linear-gradient(90deg,transparent,rgba(240,64,200,.7),transparent);opacity:.3}
.qc-4k:hover::after{opacity:1}
.qc-8k{background:linear-gradient(160deg,rgba(64,207,255,.09),rgba(240,64,200,.06));border-color:rgba(64,207,255,.20)}
.qc-8k:hover{background:linear-gradient(160deg,rgba(64,207,255,.14),rgba(240,64,200,.09));border-color:rgba(64,207,255,.40);box-shadow:0 26px 52px rgba(64,207,255,.16)}
.qc-8k::after{background:linear-gradient(90deg,transparent,rgba(64,207,255,.7),transparent);opacity:.3}
.qc-8k:hover::after{opacity:1}
.qc-badge{position:absolute;top:10px;right:10px;font-size:.56rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:3px 9px;border-radius:var(--r-pill);background:var(--grad);color:#fff;box-shadow:0 3px 10px rgba(240,64,200,.3)}
.qc-icon-wrap{width:60px;height:60px;border-radius:17px;display:grid;place-items:center;animation:qcFloat 5s ease-in-out infinite;transition:transform .4s}
.qc:hover .qc-icon-wrap{transform:scale(1.08) translateY(-2px)}
.qc:nth-child(2) .qc-icon-wrap{animation-delay:.6s}.qc:nth-child(3) .qc-icon-wrap{animation-delay:1.2s}.qc:nth-child(4) .qc-icon-wrap{animation-delay:1.8s}.qc:nth-child(5) .qc-icon-wrap{animation-delay:2.4s}
.qc-sd .qc-icon-wrap{background:linear-gradient(145deg,#1e2c6e,#2a3f9e);box-shadow:0 8px 22px rgba(85,126,255,.24)}
.qc-hd .qc-icon-wrap{background:linear-gradient(145deg,#0e4060,#1565a0);box-shadow:0 8px 22px rgba(64,207,255,.24)}
.qc-fhd .qc-icon-wrap{background:linear-gradient(145deg,#2d1b6e,#5930d6);box-shadow:0 8px 22px rgba(123,92,255,.26)}
.qc-4k .qc-icon-wrap{background:linear-gradient(145deg,#5a0e6e,#b01ab0);box-shadow:0 8px 26px rgba(240,64,200,.32)}
.qc-8k .qc-icon-wrap{background:linear-gradient(145deg,#0e4060,#6e1a90);box-shadow:0 8px 26px rgba(123,92,255,.28)}
.qc-glow-ring{position:absolute;inset:-7px;border-radius:22px;border:1px solid transparent;animation:glowRing 3s ease-in-out infinite}
.qc-4k .qc-glow-ring{border-color:rgba(240,64,200,.28)}.qc-8k .qc-glow-ring{border-color:rgba(64,207,255,.22);animation-delay:1s}
.qc-text{text-align:center}
.qc-name{font-family:'Oswald',sans-serif;font-size:1.5rem;font-weight:700;line-height:1;margin-bottom:5px}
.qc-sd .qc-name{color:#6B96FF}.qc-hd .qc-name{color:#40CFFF}
.qc-fhd .qc-name{background:linear-gradient(135deg,#9B7CFF,#F040C8);-webkit-background-clip:text;background-clip:text;color:transparent}
.qc-4k .qc-name{background:linear-gradient(135deg,#F040C8,#FF7070);-webkit-background-clip:text;background-clip:text;color:transparent}
.qc-8k .qc-name{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.qc-sub{font-size:.64rem;font-weight:500;letter-spacing:.10em;text-transform:uppercase;color:var(--muted)}
.qc-spec{display:inline-flex;padding:2px 9px;border-radius:var(--r-pill);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.06);font-size:.58rem;font-weight:600;color:var(--muted);margin-top:5px}

/* ═══ RESELLER BAR ═══ */
.rs2{width:100%;border-top:1px solid rgba(255,255,255,.055);padding:0 5%;position:relative;overflow:hidden}
.rs2::before{content:"";position:absolute;right:-5%;bottom:-20%;width:450px;height:360px;background:radial-gradient(ellipse,rgba(64,207,255,.08),transparent 70%);filter:blur(40px)}
.rs2-inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr auto;align-items:center;gap:36px;padding:32px 0;position:relative;z-index:1}
.rs2-left{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.rs2-icon-wrap{width:50px;height:50px;flex-shrink:0;border-radius:15px;background:linear-gradient(145deg,rgba(64,207,255,.15),rgba(123,92,255,.15));border:1px solid rgba(64,207,255,.20);display:grid;place-items:center;box-shadow:0 6px 20px rgba(64,207,255,.14)}
.rs2-text-block{display:flex;flex-direction:column;gap:3px}
.rs2-overline{font-family:'Oswald',sans-serif;font-size:.63rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:6px}
.rs2-overline-dot{width:4px;height:4px;border-radius:50%;background:var(--cyan);box-shadow:0 0 6px var(--cyan);animation:blink 2.2s infinite}
.rs2-title{font-family:'Oswald',sans-serif;font-size:1.25rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:#fff;line-height:1.15}
.rs2-title span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.rs2-desc{font-size:.82rem;color:var(--muted);line-height:1.6;max-width:40ch}
.rs2-pills{display:flex;gap:7px;flex-wrap:wrap}
.rs2-pill{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:var(--r-pill);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);font-size:.70rem;font-weight:500;color:var(--soft)}
.rs2-btn{display:inline-flex;align-items:center;gap:9px;height:50px;padding:0 26px;border-radius:var(--r-md);font-family:'Oswald',sans-serif;font-size:.88rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;background:var(--grad);color:#fff;box-shadow:0 8px 28px rgba(123,92,255,.26);transition:all .3s ease;white-space:nowrap}
.rs2-btn:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(240,64,200,.26)}

/* ═══ PRICING ═══ */
.pricing-section{width:100%;padding:76px 5%;position:relative;overflow:hidden;border-top:1px solid rgba(255,255,255,.055)}
.pricing-section::before{content:"";position:absolute;left:50%;top:0;transform:translateX(-50%);width:850px;height:450px;background:radial-gradient(ellipse,rgba(123,92,255,.11),rgba(240,64,200,.06),transparent 70%);filter:blur(50px);z-index:0}
.pricing-wrap{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.pricing-head{text-align:center;margin-bottom:18px}
.pricing-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:6px 15px;border-radius:var(--r-pill);background:rgba(240,64,200,.08);border:1px solid rgba(240,64,200,.20);font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#f9a8d4;margin-bottom:18px}
.pricing-eyebrow-dot{width:5px;height:5px;border-radius:50%;background:#f472b6;box-shadow:0 0 6px #f472b6;animation:blink 2s infinite}
.pricing-title{font-family:'Oswald',sans-serif;font-size:clamp(1.7rem,3.8vw,2.8rem);font-weight:700;letter-spacing:.01em;text-transform:uppercase;color:#fff;margin-bottom:10px}
.pricing-title em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.pricing-sub{font-size:.9rem;color:var(--muted);line-height:1.7;max-width:50ch;margin:0 auto 14px}
.pricing-timer{display:inline-flex;align-items:center;gap:11px;padding:10px 22px;border-radius:var(--r-pill);background:linear-gradient(120deg,rgba(255,60,80,.09),rgba(255,100,48,.07));border:1px solid rgba(255,80,60,.28);font-family:'Oswald',sans-serif;font-size:.80rem;font-weight:500;letter-spacing:.05em;color:#fca5a5;margin-bottom:44px;box-shadow:0 0 22px rgba(255,60,80,.11)}
.pricing-timer.urgent{background:linear-gradient(120deg,rgba(255,30,50,.17),rgba(255,80,20,.13));border-color:rgba(255,60,50,.52);animation:timerPulse 1.2s ease-in-out infinite}
.timer-pulse{width:7px;height:7px;border-radius:50%;background:#ff4444;flex-shrink:0;box-shadow:0 0 6px #ff4444;animation:blink 1s infinite}
.timer-display{font-weight:700;color:#fff;letter-spacing:.10em;font-size:1.1rem;font-variant-numeric:tabular-nums}
.timer-urgency{font-size:.66rem;font-weight:600;color:#f87171;opacity:0;transition:opacity .3s}
.pricing-timer.urgent .timer-urgency,.pricing-timer.urgent .timer-display{color:#ff7070}
.pricing-timer.urgent .timer-urgency{opacity:1}
.plans-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;align-items:stretch}
.plan-card{border-radius:22px;padding:26px 20px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;position:relative;overflow:hidden;transition:all .33s var(--ease)}
.plan-card::before{content:"";position:absolute;inset:0;background:var(--grad-soft);opacity:0;transition:opacity .33s ease}
.plan-card:hover{transform:translateY(-5px);border-color:rgba(255,255,255,.13);box-shadow:0 22px 48px rgba(0,0,0,.32)}
.plan-card:hover::before{opacity:1}
.plan-card.popular{background:linear-gradient(160deg,rgba(240,64,200,.10),rgba(123,92,255,.08));border-color:rgba(240,64,200,.28);box-shadow:0 0 0 1px rgba(240,64,200,.09),0 18px 46px rgba(240,64,200,.10)}
.plan-card.best-value{background:linear-gradient(160deg,rgba(64,207,255,.08),rgba(85,126,255,.06));border-color:rgba(64,207,255,.22)}
.plan-badge{position:absolute;top:13px;right:13px;padding:3px 10px;border-radius:var(--r-pill);font-family:'Oswald',sans-serif;font-size:.58rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
.badge-popular{background:var(--grad);color:#fff;box-shadow:0 3px 12px rgba(240,64,200,.28)}
.badge-value{background:rgba(64,207,255,.14);border:1px solid rgba(64,207,255,.24);color:var(--cyan)}
.badge-starter{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.09);color:var(--soft)}
.plan-duration{font-family:'Oswald',sans-serif;font-size:.70rem;font-weight:500;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;position:relative}
.plan-name{font-family:'Oswald',sans-serif;font-size:1.35rem;font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:14px;position:relative}
.plan-price{display:flex;align-items:baseline;gap:3px;margin-bottom:7px;position:relative}
.plan-price-currency{font-family:'Oswald',sans-serif;font-size:1.15rem;font-weight:600;color:var(--soft)}
.plan-price-amount{font-family:'Oswald',sans-serif;font-size:2.6rem;font-weight:700;line-height:1;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.plan-price-period{font-size:.75rem;color:var(--muted);margin-left:2px}
.plan-coupon-note{font-size:.70rem;color:#34d399;margin-bottom:12px;display:flex;align-items:center;gap:5px;font-weight:500;position:relative}
.plan-gift{display:flex;align-items:center;gap:7px;padding:7px 11px;border-radius:9px;background:rgba(240,64,200,.07);border:1px solid rgba(240,64,200,.20);font-size:.73rem;color:#f9a8d4;font-weight:500;margin-bottom:16px;position:relative}
.plan-gift i{color:#F040C8;flex-shrink:0}
.plan-sep{height:1px;background:rgba(255,255,255,.06);margin-bottom:16px;position:relative}
.plan-features{display:flex;flex-direction:column;gap:8px;flex:1;margin-bottom:20px;position:relative}
.pf{display:flex;align-items:flex-start;gap:8px;font-size:.80rem;color:var(--soft);line-height:1.4}
.pf-check{color:#34d399;font-size:.72rem;margin-top:2px;flex-shrink:0}
.pf-star{color:#fbbf24;font-size:.72rem;margin-top:2px;flex-shrink:0}
.pf-bold{font-weight:600;color:var(--text)}
.pf-adult{display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:7px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);font-size:.72rem;color:var(--muted);margin-top:3px}
.plan-btn{width:100%;height:46px;border-radius:var(--r-md);font-family:'Oswald',sans-serif;font-size:.88rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .28s ease;position:relative;overflow:hidden}
.plan-btn-primary{background:var(--grad);color:#fff;box-shadow:0 8px 26px rgba(123,92,255,.23)}
.plan-btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(240,64,200,.26)}
.plan-btn-outline{background:rgba(255,255,255,.05);color:var(--text);border:1px solid rgba(255,255,255,.11)}
.plan-btn-outline:hover{border-color:rgba(64,207,255,.34);background:rgba(64,207,255,.07)}
.plan-secure{text-align:center;margin-top:22px;display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap;font-size:.70rem;color:var(--muted)}
.plan-secure i{color:#34d399;font-size:.68rem}

/* ═══ QUICK NAV — redirect cards ═══ */
.quicknav-section{width:100%;padding:76px 5%;border-top:1px solid rgba(255,255,255,.055);position:relative;overflow:hidden}
.quicknav-section::before{content:"";position:absolute;left:50%;top:-10%;transform:translateX(-50%);width:700px;height:380px;background:radial-gradient(ellipse,rgba(64,207,255,.07),rgba(123,92,255,.06),transparent 70%);filter:blur(50px)}
.quicknav-wrap{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.quicknav-header{text-align:center;margin-bottom:48px}
.quicknav-eyebrow{display:inline-flex;align-items:center;gap:7px;font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.quicknav-dot{width:5px;height:5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 5px var(--cyan);animation:blink 2s infinite}
.quicknav-title{font-family:'Oswald',sans-serif;font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:10px}
.quicknav-title em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.quicknav-sub{font-size:.88rem;color:var(--muted);line-height:1.7;max-width:50ch;margin:0 auto}
.quicknav-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.qn-card{position:relative;border-radius:22px;padding:26px 22px 22px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;gap:14px;text-decoration:none;overflow:hidden;transition:all .33s var(--ease)}
.qn-card:hover{transform:translateY(-7px);box-shadow:0 26px 55px rgba(0,0,0,.32)}
.qn-bg{position:absolute;inset:0;opacity:0;transition:opacity .33s ease}
.qn-card:hover .qn-bg{opacity:1}
/* Contact */
.qn-contact{border-color:rgba(37,211,102,.14)}
.qn-contact:hover{border-color:rgba(37,211,102,.42);box-shadow:0 26px 55px rgba(37,211,102,.10)}
.qn-contact .qn-bg{background:linear-gradient(160deg,rgba(37,211,102,.06),transparent)}
.qn-contact .qn-icon-wrap{background:linear-gradient(145deg,#0b4d23,#16a34a)}
.qn-contact .qn-title-card{color:#4ade80}
.qn-contact .qn-badge{background:rgba(37,211,102,.14);border-color:rgba(37,211,102,.24);color:#6ee7b7}
/* Apps */
.qn-apps{border-color:rgba(123,92,255,.14)}
.qn-apps:hover{border-color:rgba(123,92,255,.42);box-shadow:0 26px 55px rgba(123,92,255,.10)}
.qn-apps .qn-bg{background:linear-gradient(160deg,rgba(123,92,255,.06),transparent)}
.qn-apps .qn-icon-wrap{background:linear-gradient(145deg,#261760,#7B5CFF)}
.qn-apps .qn-title-card{color:#a78bfa}
.qn-apps .qn-badge{background:rgba(123,92,255,.14);border-color:rgba(123,92,255,.24);color:#c4b5fd}
/* Reseller */
.qn-reseller{border-color:rgba(64,207,255,.14)}
.qn-reseller:hover{border-color:rgba(64,207,255,.42);box-shadow:0 26px 55px rgba(64,207,255,.10)}
.qn-reseller .qn-bg{background:linear-gradient(160deg,rgba(64,207,255,.06),transparent)}
.qn-reseller .qn-icon-wrap{background:linear-gradient(145deg,#0c3450,#0891b2)}
.qn-reseller .qn-title-card{color:#40CFFF}
.qn-reseller .qn-badge{background:rgba(64,207,255,.14);border-color:rgba(64,207,255,.24);color:#7dd3fc}
/* Channels */
.qn-channels{border-color:rgba(240,64,200,.14)}
.qn-channels:hover{border-color:rgba(240,64,200,.42);box-shadow:0 26px 55px rgba(240,64,200,.10)}
.qn-channels .qn-bg{background:linear-gradient(160deg,rgba(240,64,200,.06),transparent)}
.qn-channels .qn-icon-wrap{background:linear-gradient(145deg,#4a0a5a,#a818a8)}
.qn-channels .qn-title-card{color:#f0abfc}
.qn-channels .qn-badge{background:rgba(240,64,200,.14);border-color:rgba(240,64,200,.24);color:#f5d0fe}
/* Inner */
.qn-icon-wrap{width:54px;height:54px;border-radius:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 7px 22px rgba(0,0,0,.28);transition:transform .33s ease;position:relative;z-index:1}
.qn-card:hover .qn-icon-wrap{transform:scale(1.08) translateY(-2px)}
.qn-content{flex:1;position:relative;z-index:1}
.qn-label{font-family:'Oswald',sans-serif;font-size:.60rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.qn-title-card{font-family:'Oswald',sans-serif;font-size:1.3rem;font-weight:700;text-transform:uppercase;letter-spacing:.02em;margin-bottom:7px}
.qn-desc{font-size:.78rem;color:var(--muted);line-height:1.65}
.qn-footer{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}
.qn-badge{font-size:.56rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:3px 10px;border-radius:var(--r-pill);border:1px solid}
.qn-arrow-btn{width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.7rem;transition:all .28s ease}
.qn-card:hover .qn-arrow-btn{transform:translateX(4px);color:#fff;background:rgba(255,255,255,.10)}

/* ═══ DEVICES ═══ */
.devices-home-section{width:100%;padding:60px 5%;border-top:1px solid rgba(255,255,255,.055);position:relative;overflow:hidden}
.devices-home-section::before{content:"";position:absolute;right:-5%;top:20%;width:450px;height:360px;background:radial-gradient(ellipse,rgba(240,64,200,.07),transparent 65%);filter:blur(50px)}
.devices-home-wrap{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.section-label{display:flex;align-items:center;gap:14px;justify-content:center;margin-bottom:36px}
.section-label-line{flex:1;max-width:100px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.16))}
.section-label-line.right{background:linear-gradient(90deg,rgba(255,255,255,.16),transparent)}
.section-label-text{font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.devices-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.device-card{padding:20px 8px 16px;border-radius:18px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;transition:all .30s var(--ease);position:relative;overflow:hidden;cursor:default}
.device-card::before{content:"";position:absolute;inset:0;background:var(--grad-soft);opacity:0;transition:opacity .30s ease}
.device-card:hover{transform:translateY(-5px);border-color:rgba(255,255,255,.13);box-shadow:0 16px 36px rgba(0,0,0,.28)}
.device-card:hover::before{opacity:1}
.device-icon{width:56px;height:56px;border-radius:15px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;position:relative;z-index:1;box-shadow:0 5px 18px rgba(0,0,0,.32);transition:transform .30s ease}
.device-card:hover .device-icon{transform:scale(1.07) translateY(-2px)}
.device-icon svg{display:block;flex-shrink:0}
.device-name{font-family:'Oswald',sans-serif;font-size:.80rem;font-weight:700;color:#fff;letter-spacing:.03em;position:relative;z-index:1}
.device-sub{font-size:.58rem;color:var(--muted);line-height:1.3;position:relative;z-index:1}

/* ═══ TRUST STRIP ═══ */
.trust-strip{width:100%;padding:36px 5%;border-top:1px solid rgba(255,255,255,.055);border-bottom:1px solid rgba(255,255,255,.055);background:rgba(255,255,255,.015)}
.trust-strip-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap}
.trust-item{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 32px;text-align:center;border-right:1px solid rgba(255,255,255,.07)}
.trust-item:last-child{border-right:none}
.trust-item-num{font-family:'Oswald',sans-serif;font-size:1.7rem;font-weight:700;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1}
.trust-item-lbl{font-size:.65rem;font-weight:500;letter-spacing:.10em;text-transform:uppercase;color:var(--muted)}
@media(max-width:640px){.trust-item{padding:10px 18px;border-right:none;border-bottom:1px solid rgba(255,255,255,.06)}.trust-item:last-child{border-bottom:none}.trust-strip-inner{flex-direction:column;gap:0}}

/* ═══ FAQ ═══ */
.faq-section{width:100%;padding:76px 5%;border-top:1px solid rgba(255,255,255,.055);position:relative}
.faq-section::before{content:"";position:absolute;right:-5%;top:10%;width:450px;height:360px;background:radial-gradient(ellipse,rgba(240,64,200,.06),transparent 65%);filter:blur(50px)}
.faq-wrap{max-width:860px;margin:0 auto;position:relative;z-index:1}
.faq-head{text-align:center;margin-bottom:48px}
.faq-eyebrow{display:inline-flex;align-items:center;gap:7px;font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.faq-dot{width:5px;height:5px;border-radius:50%;background:var(--violet);box-shadow:0 0 6px var(--violet);animation:blink 2.2s infinite}
.faq-title{font-family:'Oswald',sans-serif;font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:10px}
.faq-title em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.faq-sub{font-size:.88rem;color:var(--muted);line-height:1.7}
.faq-grid{display:flex;flex-direction:column;gap:9px}
.faq-item{border-radius:16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);overflow:hidden;transition:border-color .22s ease}
.faq-item:hover{border-color:rgba(123,92,255,.22)}
.faq-item.open{border-color:rgba(123,92,255,.33);background:rgba(123,92,255,.04)}
.faq-q{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 19px;font-family:'Oswald',sans-serif;font-size:.95rem;font-weight:500;letter-spacing:.02em;text-transform:uppercase;color:var(--text);cursor:pointer;user-select:none}
.faq-q span{flex:1}
.faq-arrow{font-size:.75rem;color:var(--muted);flex-shrink:0;transition:transform .28s ease,color .22s ease}
.faq-item.open .faq-arrow{transform:rotate(180deg);color:var(--violet)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .38s ease;padding:0 19px;font-size:.86rem;color:var(--muted);line-height:1.78}
.faq-item.open .faq-a{max-height:280px;padding-bottom:17px}

/* ═══ SEO BLOCK ═══ */
.seo-section{width:100%;padding:64px 5% 56px;border-top:1px solid rgba(255,255,255,.055);background:linear-gradient(180deg,rgba(123,92,255,.03),transparent)}
.seo-wrap{max-width:1280px;margin:0 auto}
.seo-grid{display:grid;grid-template-columns:1fr 1fr;gap:38px 52px}
.seo-block{display:flex;flex-direction:column;gap:12px}
.seo-h2{font-family:'Oswald',sans-serif;font-size:1rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--soft);line-height:1.3}
.seo-p{font-size:.82rem;color:var(--muted);line-height:1.8}
.seo-p strong{color:var(--soft);font-weight:600}

/* ═══ FOOTER ═══ */
.site-footer{width:100%;background:linear-gradient(180deg,var(--bg-3),#050812);border-top:1px solid rgba(255,255,255,.07);padding:60px 5% 0;position:relative;overflow:hidden}
.footer-glow{position:absolute;left:20%;top:-10%;width:650px;height:280px;background:radial-gradient(ellipse,rgba(123,92,255,.07),transparent 65%);filter:blur(50px)}
.footer-wrap{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.footer-top{display:grid;grid-template-columns:auto 1fr;gap:56px;padding-bottom:44px;border-bottom:1px solid rgba(255,255,255,.06);align-items:flex-start}
.footer-brand{display:flex;align-items:flex-start;gap:13px}
.footer-brand-icon{width:52px;height:52px;border-radius:15px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:1.25rem;flex-shrink:0;box-shadow:0 6px 22px rgba(123,92,255,.24)}
.footer-brand-name{font-family:'Oswald',sans-serif;font-size:1.25rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff;margin-bottom:4px}
.footer-brand-name span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.footer-brand-sub{font-size:.75rem;color:var(--muted);line-height:1.5;margin-bottom:14px;max-width:24ch}
.footer-contact-row{display:flex;flex-wrap:wrap;gap:7px}
.footer-contact-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:var(--r-md);font-size:.74rem;font-weight:600;transition:all .22s ease}
.footer-wa{background:rgba(37,211,102,.09);border:1px solid rgba(37,211,102,.20);color:#6ee7b7}
.footer-wa:hover{background:rgba(37,211,102,.16);border-color:rgba(37,211,102,.36)}
.footer-em{background:rgba(123,92,255,.09);border:1px solid rgba(123,92,255,.20);color:#c4b5fd}
.footer-em:hover{background:rgba(123,92,255,.16);border-color:rgba(123,92,255,.36)}
.footer-links-group{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.footer-col{display:flex;flex-direction:column;gap:9px}
.footer-col-title{font-family:'Oswald',sans-serif;font-size:.67rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--soft);margin-bottom:5px}
.footer-link{font-size:.80rem;color:var(--muted);transition:color .2s ease;display:flex;align-items:center;gap:5px}
.footer-link:hover{color:var(--cyan)}
.footer-link i{font-size:.52rem;opacity:.5}
.footer-bottom{padding:18px 0 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.footer-copy{font-size:.70rem;color:var(--muted);line-height:1.5}
.footer-bottom-links{display:flex;gap:16px}
.footer-bottom-link{font-size:.70rem;color:var(--muted);transition:color .2s ease}
.footer-bottom-link:hover{color:var(--soft)}

/* ═══ ORDER MODAL ═══ */
.modal-overlay{display:none;position:fixed;inset:0;z-index:10000;background:rgba(4,6,18,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);align-items:center;justify-content:center;padding:14px}
.modal-overlay.open{display:flex}
.modal{width:100%;max-width:500px;border-radius:26px;background:linear-gradient(160deg,#0E1128,#12103A);border:1px solid rgba(255,255,255,.10);box-shadow:0 40px 90px rgba(0,0,0,.60);overflow:hidden;max-height:90vh;overflow-y:auto}
.modal::-webkit-scrollbar{width:4px}.modal::-webkit-scrollbar-thumb{background:rgba(255,255,255,.10);border-radius:4px}
.modal-welcome{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 17px;background:linear-gradient(120deg,rgba(52,211,153,.16),rgba(56,208,255,.09));border-bottom:1px solid rgba(52,211,153,.22)}
.mw-left{display:flex;align-items:flex-start;gap:10px}
.mw-emoji{font-size:1.35rem;flex-shrink:0;line-height:1}
.mw-title{font-family:'Oswald',sans-serif;font-size:.86rem;font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:3px}
.mw-sub{font-size:.74rem;color:rgba(255,255,255,.68);line-height:1.4}
.mw-price-old{text-decoration:line-through;color:rgba(255,255,255,.38);margin-right:3px}
.mw-price-new{font-family:'Oswald',sans-serif;font-size:1rem;font-weight:700;color:#34d399}
.mw-close-btn{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.08);border-radius:7px;width:24px;height:24px;cursor:pointer;color:rgba(255,255,255,.55);display:grid;place-items:center;flex-shrink:0;transition:all .2s}
.mw-close-btn:hover{background:rgba(255,255,255,.16);color:#fff}
.modal-head{padding:22px 22px 18px;background:linear-gradient(135deg,rgba(123,92,255,.11),rgba(240,64,200,.07));border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.modal-rocket{font-size:1.4rem;margin-bottom:5px}
.modal-title{font-family:'Oswald',sans-serif;font-size:1.35rem;font-weight:700;text-transform:uppercase;color:#fff}
.modal-plan-label{display:inline-flex;align-items:center;padding:3px 11px;border-radius:var(--r-pill);background:var(--grad);color:#fff;font-family:'Oswald',sans-serif;font-size:.67rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin-top:7px}
.modal-close{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:var(--muted);cursor:pointer;display:grid;place-items:center;font-size:.85rem;flex-shrink:0;transition:all .2s}
.modal-close:hover{background:rgba(255,255,255,.10);color:#fff}
.modal-body{padding:20px}
.modal-form{display:flex;flex-direction:column;gap:12px}
