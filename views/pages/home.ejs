<script>
/* ═══ AUTO YEAR ═══ */
(function(){var y=new Date().getFullYear();document.querySelectorAll('.js-year').forEach(function(el){el.textContent=y;});})();

/* ═══ NAVBAR ═══ */
function toggleNav(){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  var o=d.classList.toggle('open');
  h.classList.toggle('open',o);
  h.setAttribute('aria-expanded',o?'true':'false');
  document.body.style.overflow=o?'hidden':'';
}
function closeNav(){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  d.classList.remove('open');h.classList.remove('open');
  h.setAttribute('aria-expanded','false');
  document.body.style.overflow='';
}
document.addEventListener('click',function(e){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  if(d&&h&&d.classList.contains('open')&&!d.contains(e.target)&&!h.contains(e.target)){closeNav();}
});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeNav();closeModal();}});

/* ═══ MODAL ═══ */
var currentPlan='',currentPrice=0,selectedPayment='';
function openModal(plan,price){
  currentPlan=plan;selectedPayment='';
  document.getElementById('modalPlanLabel').textContent=plan;
  document.querySelectorAll('.pay-opt').forEach(function(o){o.classList.remove('selected');});
  var priceEl=document.getElementById('modalPriceValue');
  var oldEl=document.getElementById('mpriceOld');
  var planEl=document.getElementById('mpricePlan');
  var savingEl=document.getElementById('msavingBadge');
  var welcomeEl=document.getElementById('modalWelcome');
  if(planEl)planEl.textContent=plan;
  if(price===65){
    currentPrice=55;
    if(priceEl)priceEl.textContent='\u20AC55';
    if(oldEl)oldEl.style.display='block';
    if(savingEl)savingEl.style.display='flex';
    if(welcomeEl)welcomeEl.style.display='flex';
  }else{
    currentPrice=price;
    if(priceEl)priceEl.textContent='\u20AC'+price;
    if(oldEl)oldEl.style.display='none';
    if(savingEl)savingEl.style.display='none';
    if(welcomeEl)welcomeEl.style.display='none';
  }
  var overlay=document.getElementById('orderModal');
  overlay.classList.add('open');
  document.body.style.overflow='hidden';
  var m=overlay.querySelector('.modal');if(m)m.scrollTop=0;
}
function closeModal(){
  document.getElementById('orderModal').classList.remove('open');
  document.body.style.overflow='';
}
function closeModalOutside(e){if(e.target===document.getElementById('orderModal'))closeModal();}
function selectPay(el,name){
  document.querySelectorAll('.pay-opt').forEach(function(o){o.classList.remove('selected');});
  el.classList.add('selected');selectedPayment=name;
}
function submitOrder(channel){
  var name=document.getElementById('mName').value.trim()||'Not provided';
  var email=document.getElementById('mEmail').value.trim();
  var phone=document.getElementById('mPhone').value.trim();
  var country=document.getElementById('mCountry').value;
  if(!email||!phone||!country){alert('Please fill in your Email, WhatsApp number and Country.');return;}
  if(!selectedPayment){alert('Please select a payment method.');return;}
  var fp='\u20AC'+currentPrice;

  // Background dispatch to Telegram Bot & Google Sheets (non-blocking)
  try {
    fetch('/api/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        plan: currentPlan,
        amount: fp,
        name: name,
        email: email,
        phone: phone,
        country: country,
        paymentMethod: selectedPayment,
        channel: channel,
        type: 'subscription'
      })
    }).catch(function(e){ console.warn('Order background log:', e); });
  } catch(e){}

  if(channel==='whatsapp'){
    var msg='\uD83D\uDE80 *New one4k Order*\n\n\uD83D\uDCE6 *Plan:* '+currentPlan+'\n\uD83D\uDCB0 *Amount:* '+fp+'\n\uD83D\uDC64 *Name:* '+name+'\n\uD83D\uDCE7 *Email:* '+email+'\n\uD83D\uDCF1 *WhatsApp:* '+phone+'\n\uD83C\uDF0D *Country:* '+country+'\n\uD83D\uDCB3 *Payment:* '+selectedPayment;
    window.open('https://wa.me/447311129243?text='+encodeURIComponent(msg),'_blank');
  }else{
    var subj='one4k Order \u2014 '+currentPlan+' \u2014 '+fp;
    var body='New one4k Order\n\nPlan: '+currentPlan+'\nAmount: '+fp+'\nName: '+name+'\nEmail: '+email+'\nWhatsApp: '+phone+'\nCountry: '+country+'\nPayment: '+selectedPayment;
    window.open('mailto:TVBillingTeam@gmail.com?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(body),'_blank');
  }
  closeModal();
  alert('\u2705 Your order details have been sent! Our team will contact you within a few minutes.');
}

/* ═══ FAQ ═══ */
function toggleFaq(el){
  var wasOpen=el.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(function(f){f.classList.remove('open');});
  if(!wasOpen)el.classList.add('open');
}

/* ═══ COUNTDOWN TIMER ═══ */
(function(){
  var KEY='tivi_offer_end',DUR=30*60*1000;
  var stored=localStorage.getItem(KEY),end;
  try{
    if(stored){end=new Date(parseInt(stored));if(end<new Date()){end=new Date(Date.now()+DUR);localStorage.setItem(KEY,end.getTime());}}
    else{end=new Date(Date.now()+DUR);localStorage.setItem(KEY,end.getTime());}
  }catch(e){end=new Date(Date.now()+DUR);}
  function pad(n){return n<10?'0'+n:''+n;}
  function tick(){
    var now=new Date(),d=end-now;
    if(d<0){try{end=new Date(Date.now()+DUR);localStorage.setItem(KEY,end.getTime());}catch(e){}d=DUR;}
    var m=Math.floor(d/60000),s=Math.floor((d%60000)/1000);
    var el=document.getElementById('pricingTimer'),bar=document.getElementById('pricingTimerBar'),urg=document.getElementById('timerUrgency');
    if(el)el.textContent=pad(m)+':'+pad(s);
    if(bar){if(m<5){bar.classList.add('urgent');if(urg)urg.textContent='\u26A1 Almost Gone!';}else{bar.classList.remove('urgent');if(urg)urg.textContent='';}}
  }
  tick();setInterval(tick,1000);
})();

/* ═══ SCROLL REVEAL (lightweight) ═══ */
(function(){
  if(!('IntersectionObserver' in window))return;
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
