<script>
  /* Navbar */
  function toggleNav(){
    var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
    var o=d.classList.toggle('open');h.classList.toggle('open',o);
  }
  function closeNav(){
    document.getElementById('nvDrawer').classList.remove('open');
    document.getElementById('nvHam').classList.remove('open');
  }
  document.addEventListener('click',function(e){
    var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
    if(d&&h&&!d.contains(e.target)&&!h.contains(e.target)){d.classList.remove('open');h.classList.remove('open');}
  });

  /* ══ Navigate to contact page with subject pre-selection ══
     Stores the chosen subject in sessionStorage so the contact page
     can read it on load and pre-select the right button + show the banner.
  */
  function goContact(e, subject){
    if(e) e.preventDefault();
    try{ sessionStorage.setItem('tivi_contact_subject', subject); }catch(err){}
    window.location.href = '../contact-us/index.html#contact-form';
  }

  /* Copy to clipboard */
  function copyText(text, btn){
    navigator.clipboard.writeText(text).then(function(){
      btn.classList.add('ok');
      btn.innerHTML='<i class="fas fa-check"></i>';
      setTimeout(function(){
        btn.classList.remove('ok');
        btn.innerHTML='<i class="fas fa-copy"></i>';
      },2000);
    }).catch(function(){
      var el=document.createElement('textarea');
      el.value=text;document.body.appendChild(el);el.select();
      document.execCommand('copy');document.body.removeChild(el);
      btn.classList.add('ok');btn.innerHTML='<i class="fas fa-check"></i>';
      setTimeout(function(){btn.classList.remove('ok');btn.innerHTML='<i class="fas fa-copy"></i>';},2000);
    });
  }
</script>
