<script>
/* ══ AUTO YEAR ══ */
(function(){var y=new Date().getFullYear();document.querySelectorAll('.js-year').forEach(function(el){el.textContent=y;});})();

/* ══ NAVBAR ══ */
function toggleNav(){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  var o=d.classList.toggle('open');h.classList.toggle('open',o);
  h.setAttribute('aria-expanded',o?'true':'false');
  document.body.style.overflow=o?'hidden':'';
}
function closeNav(){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  d.classList.remove('open');h.classList.remove('open');
  h.setAttribute('aria-expanded','false');document.body.style.overflow='';
}
document.addEventListener('click',function(e){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  if(d&&h&&d.classList.contains('open')&&!d.contains(e.target)&&!h.contains(e.target))closeNav();
});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeNav();closeRsModal();}});

/* ══ PACKAGE PICKER ══ */
var rsCr=240, rsPrice=550;
function pickPkg(el,cr,price){
  document.querySelectorAll('.pkg-pick').forEach(function(o){o.classList.remove('selected');});
  el.classList.add('selected');
  rsCr=cr; rsPrice=price;
  var label=cr+' Credits — Reseller Panel';
  var amt='€'+price.toLocaleString();
  document.getElementById('pkgPickLabel').textContent=label;
  document.getElementById('pkgPickTotal').textContent=amt;
}

/* ══ OPEN MODAL ══ */
function rsOpenFromCard(cr,price){
  rsCr=cr; rsPrice=price;
  // Sync the picker highlight
  document.querySelectorAll('.pkg-pick').forEach(function(el){
    if(parseInt(el.getAttribute('data-cr'))===cr){el.classList.add('selected');}
    else{el.classList.remove('selected');}
  });
  // Update summary
  document.getElementById('pkgPickLabel').textContent=cr+' Credits — Reseller Panel';
  document.getElementById('pkgPickTotal').textContent='€'+price.toLocaleString();
  openResellerModal();
}
function openResellerModal(){
  var label=rsCr+' Credits — €'+rsPrice.toLocaleString();
  document.getElementById('rsPkgLabel').textContent=label;
  document.getElementById('rsMpricePkg').textContent=rsCr+' Credits — Reseller Panel';
  document.getElementById('rsMpriceAmt').textContent='€'+rsPrice.toLocaleString();
  // Reset form
  ['rsName','rsEmail','rsPhone','rsUser','rsPass'].forEach(function(id){
    var el=document.getElementById(id);if(el)el.value='';
  });
  document.querySelectorAll('.rs-pay-opt').forEach(function(o){o.classList.remove('selected');});
  rsSelectedPay='';
  var overlay=document.getElementById('rsModal');
  overlay.classList.add('open');
  document.body.style.overflow='hidden';
  var m=overlay.querySelector('.rs-modal');if(m)m.scrollTop=0;
}

/* ══ Package card "Order Now" buttons → open modal ══ */
function selectPkg(btn,cr,price){
  rsOpenFromCard(cr,price);
}

function closeRsModal(){
  document.getElementById('rsModal').classList.remove('open');
  document.body.style.overflow='';
}
function closeRsModalOutside(e){if(e.target===document.getElementById('rsModal'))closeRsModal();}

/* ══ PAYMENT SELECTION ══ */
var rsSelectedPay='';
function rsSelectPay(el,name){
  document.querySelectorAll('.rs-pay-opt').forEach(function(o){o.classList.remove('selected');});
  el.classList.add('selected');rsSelectedPay=name;
}

/* ══ SUBMIT ══ */
function rsSubmitOrder(channel){
  var name=document.getElementById('rsName').value.trim();
  var email=document.getElementById('rsEmail').value.trim();
  var phone=document.getElementById('rsPhone').value.trim();
  var user=document.getElementById('rsUser').value.trim();
  var pass=document.getElementById('rsPass').value.trim();
  if(!name||!email||!phone||!user||!pass){
    alert('⚠️ Please fill in all required fields.');return;
  }
  if(!rsSelectedPay){alert('⚠️ Please select a payment method.');return;}
  var pkg=rsCr+' Credits — €'+rsPrice.toLocaleString();

  // Background dispatch to Telegram Bot & Google Sheets (non-blocking)
  try {
    fetch('/api/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        plan: 'Reseller: ' + pkg,
        amount: '€' + rsPrice.toLocaleString(),
        name: name,
        email: email,
        phone: phone,
        country: 'Reseller Application',
        paymentMethod: rsSelectedPay,
        channel: channel,
        type: 'reseller',
        username: user,
        password: pass
      })
    }).catch(function(e){ console.warn('Reseller order background log:', e); });
  } catch(e){}

  if(channel==='whatsapp'){
    var lines=[
      '🏪 *one4k Reseller Application*',
      '',
      '📦 *Package:* '+pkg,
      '💳 *Payment:* '+rsSelectedPay,
      '👤 *Name:* '+name,
      '📧 *Email:* '+email,
      '📱 *WhatsApp:* '+phone,
      '🔑 *Username:* '+user,
      '🔒 *Password:* '+pass
    ];
    var msg=lines.join('\n');
    window.open('https://wa.me/447311129243?text='+encodeURIComponent(msg),'_blank');
  }else{
    var subj='one4k Reseller Application — '+pkg;
    var parts=['one4k Reseller Application','','Package: '+pkg,'Payment: '+rsSelectedPay,'Name: '+name,'Email: '+email,'WhatsApp: '+phone,'Username: '+user,'Password: '+pass];
    var body=parts.join('\n');
    window.open('mailto:TVBillingTeam@gmail.com?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(body),'_blank');
  }
  closeRsModal();
  alert('✅ Application sent! Panel activated within 5–10 minutes.');
}

/* ══ SCROLL REVEAL ══ */
(function(){
  if(!('IntersectionObserver' in window))return;
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='none';obs.unobserve(e.target);}
    });
  },{threshold:0.08});
  document.querySelectorAll('.benefit-card,.pkg-card,.how-step,.device-card').forEach(function(el,i){
    el.style.opacity='0';el.style.transform='translateY(16px)';
    el.style.transition='opacity .42s ease '+((i%6)*.06)+'s, transform .42s ease '+((i%6)*.06)+'s';
    obs.observe(el);
  });
})();

  /* ══ openModal compatibility (called by pkg-card buttons) ══ */
  function openModal(plan, price){
    var match = String(plan).match(/^(\d+)/);
    rsCr = match ? parseInt(match[1]) : price;
    rsPrice = price;
    document.querySelectorAll('.pkg-pick').forEach(function(el){
      var cr = parseInt(el.getAttribute('data-cr'));
      if(cr === rsCr) el.classList.add('selected');
      else el.classList.remove('selected');
    });
    var lbl = document.getElementById('pkgPickLabel');
    var tot = document.getElementById('pkgPickTotal');
    if(lbl) lbl.textContent = rsCr + ' Credits — Reseller Panel';
    if(tot) tot.textContent = '€' + price.toLocaleString();
    openResellerModal();
  }

  
</script>

<!-- ═══ RESELLER ORDER MODAL ═══ -->
