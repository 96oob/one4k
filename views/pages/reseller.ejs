                <span class="rs-contact-sub">TVBillingTeam@gmail.com</span>
              </span>
            </button>
          </div>
        </div>
        <div class="rs-modal-tip">
          <i class="fas fa-circle-info" style="color:var(--cyan);font-size:.68rem;margin-top:2px" aria-hidden="true"></i>
          <span>Send via <strong>WhatsApp</strong> for instant confirmation — your panel will be ready within 5–10 minutes of payment.</span>
        </div>
        <p class="rs-modal-sec"><i class="fas fa-lock" aria-hidden="true"></i> Your information is secure and never shared with third parties.</p>
      </div>
    </div>
  </div>
