.pkg-head-banner::before{content:"";position:absolute;inset:0;background:var(--band);opacity:.85}
.pkg-band-glow{position:absolute;top:-30%;right:-10%;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,var(--glow-c),transparent 65%);filter:blur(22px);animation:pulseGlow 3s ease-in-out infinite;pointer-events:none}
.pkg-big-price{font-family:'Oswald',sans-serif;font-size:3.2rem;font-weight:700;line-height:1;color:#fff;margin-bottom:6px;letter-spacing:-0.02em;position:relative;z-index:1}
.pkg-big-credits{font-family:'Oswald',sans-serif;font-size:1.4rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:.02em;margin-bottom:10px;position:relative;z-index:1}
