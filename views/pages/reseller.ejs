.pkg-system-row{font-size:.82rem;color:var(--soft);display:flex;align-items:center;gap:8px;font-weight:500}
.pkg-system-row i{color:var(--cyan);font-size:.70rem}
.pkg-features-list{display:flex;flex-direction:column;gap:9px;flex:1}
.pkg-feat-item{display:flex;align-items:center;gap:10px;font-size:.83rem;color:var(--soft)}
.pkg-feat-item i{color:#34d399;font-size:.80rem;flex-shrink:0}
.pkg-btn{width:100%;height:48px;border-radius:var(--r-md);font-family:'Oswald',sans-serif;font-size:.92rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .28s ease;border:none;cursor:pointer}
.pkg-btn-primary{background:var(--grad);color:#fff;box-shadow:0 8px 24px rgba(123,92,255,.22)}
.pkg-btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(240,64,200,.26)}
.pkg-btn-outline{background:rgba(255,255,255,.05);color:var(--text);border:1px solid rgba(255,255,255,.11)}
.pkg-btn-outline:hover{border-color:rgba(64,207,255,.34);background:rgba(64,207,255,.07)}
.pkg-secure-note{font-size:.72rem;color:var(--muted);text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;margin-top:8px}
.pkg-secure-note i{color:#34d399;font-size:.70rem}

/* ══ HOW IT WORKS ══ */
.how-section{border-top:1px solid rgba(255,255,255,.055)}
.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative;margin-top:44px}
.steps-grid::before{content:"";position:absolute;top:32px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.10),rgba(255,255,255,.10),transparent);z-index:0}
.how-step{padding:24px 20px;border-radius:var(--r-xl);background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);position:relative;z-index:1;transition:all .30s var(--ease)}
.how-step:hover{border-color:rgba(64,207,255,.22);transform:translateY(-4px)}
.step-num{font-family:'Oswald',sans-serif;font-size:2rem;font-weight:700;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;margin-bottom:14px}
.step-icon{width:40px;height:40px;border-radius:12px;background:rgba(64,207,255,.10);border:1px solid rgba(64,207,255,.18);display:grid;place-items:center;color:var(--cyan);font-size:.92rem;margin-bottom:12px}
.step-title{font-family:'Oswald',sans-serif;font-size:.92rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:#fff;margin-bottom:7px}
.step-desc{font-size:.78rem;color:var(--muted);line-height:1.65}

/* ══ ORDER FORM ══ */
.form-section{border-top:1px solid rgba(255,255,255,.055)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:flex-start;margin-top:44px}
.form-left{display:flex;flex-direction:column;gap:20px}
.form-card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-xl);padding:32px;display:flex;flex-direction:column;gap:16px}
.form-title{font-family:'Oswald',sans-serif;font-size:1.3rem;font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:4px}
.form-subtitle{font-size:.84rem;color:var(--muted);line-height:1.6}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-label{font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.10em;text-transform:uppercase;color:var(--muted)}
.form-input,.form-select{width:100%;height:46px;padding:0 14px;border-radius:var(--r-md);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);color:#fff;font-family:'DM Sans',sans-serif;font-size:.88rem;outline:none;transition:all .22s ease;-webkit-appearance:none}
.form-input::placeholder{color:var(--muted)}
.form-select option{background:#0E1128;color:#fff}
.form-input:focus,.form-select:focus{border-color:rgba(64,207,255,.40);background:rgba(64,207,255,.06);box-shadow:0 0 0 3px rgba(64,207,255,.09)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
/* Package selector */
.pkg-select-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pkg-sel-opt{padding:10px 8px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);cursor:pointer;text-align:center;transition:all .2s ease}
.pkg-sel-opt:hover{border-color:rgba(64,207,255,.28);background:rgba(64,207,255,.06)}
.pkg-sel-opt.selected{border-color:rgba(64,207,255,.40);background:rgba(64,207,255,.10)}
.pkg-sel-cr{font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:700;color:#fff}
.pkg-sel-price{font-size:.68rem;color:var(--cyan);margin-top:2px}
/* Payment grid */
.pay-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.pay-opt{padding:9px 6px;border-radius:9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;transition:all .2s ease}
.pay-opt:hover{border-color:rgba(123,92,255,.28);background:rgba(123,92,255,.06)}
.pay-opt.selected{border-color:rgba(123,92,255,.48);background:rgba(123,92,255,.10)}
.pay-ico{font-size:1.15rem}.pay-lbl{font-size:.58rem;font-weight:600;letter-spacing:.04em;color:var(--muted);text-transform:uppercase;text-align:center}
.pay-opt.selected .pay-lbl{color:var(--soft)}
/* Submit buttons */
.submit-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.submit-btn{height:50px;border-radius:var(--r-md);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;font-family:'DM Sans',sans-serif;font-size:.90rem;font-weight:700;transition:all .22s ease}
.submit-wa{background:linear-gradient(120deg,#25D366,#128C7E);color:#fff;box-shadow:0 4px 16px rgba(37,211,102,.22)}
.submit-wa:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(37,211,102,.28)}
.submit-em{background:rgba(123,92,255,.12);border:1px solid rgba(123,92,255,.25);color:#c4b5fd}
.submit-em:hover{background:rgba(123,92,255,.20);border-color:rgba(123,92,255,.40)}
/* Form right — info */
.form-right{display:flex;flex-direction:column;gap:18px}
.info-card{border-radius:var(--r-xl);padding:26px;display:flex;flex-direction:column;gap:14px}
.info-card-cyan{background:linear-gradient(135deg,rgba(64,207,255,.08),rgba(123,92,255,.06));border:1px solid rgba(64,207,255,.18)}
.info-card-green{background:rgba(37,211,102,.06);border:1px solid rgba(37,211,102,.18)}
.info-card-violet{background:rgba(123,92,255,.07);border:1px solid rgba(123,92,255,.18)}
.info-card-title{font-family:'Oswald',sans-serif;font-size:.90rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff;display:flex;align-items:center;gap:9px}
.info-card-title i{font-size:.85rem}
.info-row{display:flex;align-items:flex-start;gap:11px;font-size:.82rem;color:var(--soft);line-height:1.6}
.info-row i{color:var(--cyan);font-size:.78rem;margin-top:3px;flex-shrink:0}
.info-row.green i{color:#34d399}
.info-row.violet i{color:#a78bfa}
.info-highlight{font-size:.80rem;color:var(--muted);line-height:1.65;padding:12px 14px;border-radius:var(--r-md);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)}
.info-highlight strong{color:#fff;font-weight:500}
.panel-link{display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border-radius:var(--r-md);background:rgba(64,207,255,.08);border:1px solid rgba(64,207,255,.20);color:var(--cyan);font-size:.82rem;font-weight:600;transition:all .22s ease}
.panel-link:hover{background:rgba(64,207,255,.14);border-color:rgba(64,207,255,.36)}

/* ══ ADULT CONTENT NOTE ══ */
.adult-note{margin:0 5% 0;padding:18px 24px;border-radius:var(--r-lg);background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);display:flex;align-items:flex-start;gap:14px}
.adult-note i{font-size:1rem;color:var(--muted);flex-shrink:0;margin-top:2px}
.adult-note p{font-size:.80rem;color:var(--muted);line-height:1.70}
.adult-note p strong{color:var(--soft);font-weight:500}

/* ══ DEVICES ══ */
.devices-section{border-top:1px solid rgba(255,255,255,.055)}
.devices-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:13px;margin-top:40px}
.device-card{padding:18px 10px 14px;border-radius:18px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center;transition:all .28s var(--ease)}
.device-card:hover{border-color:rgba(64,207,255,.22);background:rgba(64,207,255,.05);transform:translateY(-4px)}
.device-icon{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;overflow:hidden;flex-shrink:0;box-shadow:0 4px 14px rgba(0,0,0,.30)}
.device-name{font-family:'Oswald',sans-serif;font-size:.80rem;font-weight:700;color:#fff}
.device-sub{font-size:.60rem;color:var(--muted);line-height:1.3}

/* ══ CTA BAND ══ */
.cta-band{margin:0 5% 80px;padding:52px;border-radius:var(--r-xl);background:linear-gradient(135deg,rgba(64,207,255,.08),rgba(123,92,255,.10),rgba(240,64,200,.07));border:1px solid rgba(123,92,255,.22);text-align:center;position:relative;overflow:hidden}
.cta-band::before{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:650px;height:320px;background:radial-gradient(ellipse,rgba(123,92,255,.15),transparent 65%);filter:blur(40px);pointer-events:none}
.cta-band-title{font-family:'Oswald',sans-serif;font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:12px;position:relative}
.cta-band-title em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.cta-band-sub{font-size:.92rem;color:var(--muted);line-height:1.7;max-width:50ch;margin:0 auto 28px;position:relative}
.cta-btns{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;position:relative}
.cta-btn{display:inline-flex;align-items:center;gap:9px;height:52px;padding:0 28px;border-radius:var(--r-md);font-family:'Oswald',sans-serif;font-size:.92rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;transition:all .3s ease;border:none;cursor:pointer}
.cta-btn-primary{background:var(--grad);color:#fff;box-shadow:0 10px 32px rgba(123,92,255,.28)}
.cta-btn-primary:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(240,64,200,.28)}
.cta-btn-ghost{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:var(--soft)}
.cta-btn-ghost:hover{border-color:rgba(37,211,102,.34);background:rgba(37,211,102,.07);color:#86efac}

/* ══ FOOTER ══ */
.site-footer{width:100%;background:linear-gradient(180deg,var(--bg-3),#050812);border-top:1px solid rgba(255,255,255,.07);padding:60px 5% 0;position:relative;overflow:hidden}
.footer-glow{position:absolute;left:20%;top:-10%;width:650px;height:280px;background:radial-gradient(ellipse,rgba(123,92,255,.07),transparent 65%);filter:blur(50px)}
.footer-wrap{max-width:1280px;margin:0 auto;position:relative;z-index:1}
.footer-top{display:grid;grid-template-columns:auto 1fr;gap:56px;padding-bottom:44px;border-bottom:1px solid rgba(255,255,255,.06);align-items:flex-start}
.footer-brand{display:flex;align-items:flex-start;gap:13px}
.footer-brand-icon{width:44px;height:44px;border-radius:12px;overflow:hidden;flex-shrink:0}
.footer-brand-icon img{width:100%;height:100%;object-fit:contain;background:transparent}
.footer-brand-name{font-family:'Oswald',sans-serif;font-size:1.25rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff;margin-bottom:4px}
.footer-brand-name span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.footer-brand-sub{font-size:.75rem;color:var(--muted);line-height:1.5;margin-bottom:14px;max-width:24ch}
.footer-contact-row{display:flex;flex-wrap:wrap;gap:7px}
.footer-contact-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:var(--r-md);font-size:.74rem;font-weight:600;transition:all .22s ease}
.footer-wa{background:rgba(37,211,102,.09);border:1px solid rgba(37,211,102,.20);color:#6ee7b7}
.footer-wa:hover{background:rgba(37,211,102,.16);border-color:rgba(37,211,102,.36)}
.footer-em{background:rgba(123,92,255,.09);border:1px solid rgba(123,92,255,.20);color:#c4b5fd}
.footer-em:hover{background:rgba(123,92,255,.16);border-color:rgba(123,92,255,.36)}
.footer-links-group{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.footer-col{display:flex;flex-direction:column;gap:9px}
.footer-col-title{font-family:'Oswald',sans-serif;font-size:.67rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--soft);margin-bottom:5px}
.footer-link{font-size:.80rem;color:var(--muted);transition:color .2s ease;display:flex;align-items:center;gap:5px}
.footer-link:hover{color:var(--cyan)}
.footer-bottom{padding:18px 0 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.footer-copy{font-size:.70rem;color:var(--muted);line-height:1.5}
.footer-bottom-links{display:flex;gap:16px}
.footer-bottom-link{font-size:.70rem;color:var(--muted);transition:color .2s ease}
.footer-bottom-link:hover{color:var(--soft)}

/* ══ RESPONSIVE ══ */
@media(max-width:1100px){
  .benefits-grid{grid-template-columns:repeat(2,1fr)}
  .packages-grid{grid-template-columns:repeat(2,1fr)}
  .form-grid{grid-template-columns:1fr;gap:36px}
  .footer-top{grid-template-columns:1fr;gap:32px}
}
@media(max-width:820px){
  .steps-grid{grid-template-columns:repeat(2,1fr)}
  .steps-grid::before{display:none}
  .devices-grid{grid-template-columns:repeat(4,1fr)}
  .footer-links-group{grid-template-columns:1fr 1fr}
  .cta-band{padding:36px 24px;margin:0 4% 60px}
}
@media(max-width:600px){
  .rs-hero{padding:52px 4% 60px}
  .rs-section{padding:56px 4%}
  .benefits-grid{grid-template-columns:1fr}
  .packages-grid{grid-template-columns:1fr}
  .steps-grid{grid-template-columns:1fr}
  .devices-grid{grid-template-columns:repeat(3,1fr)}
  .form-row{grid-template-columns:1fr}
  .pkg-select-grid{grid-template-columns:repeat(2,1fr)}
  .submit-grid{grid-template-columns:1fr}
  .footer-links-group{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;align-items:flex-start}
  .cta-btns{flex-direction:column;align-items:stretch}
  .cta-btn{justify-content:center}
  .adult-note{margin:0 4% 0;padding:14px 16px}
  .rs-hero-btns .rs-btn{width:100%;justify-content:center}
  .rs-hero-btns{flex-direction:column;align-items:stretch;padding:0 4%}
}
@media(max-width:380px){
  .devices-grid{grid-template-columns:repeat(2,1fr)}
  .pay-grid{grid-template-columns:repeat(3,1fr)}
}

    /* ── PACKAGE PICKER ── */
    .pkg-pick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px}
    .pkg-pick{
      padding:14px 10px;border-radius:12px;
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
      cursor:pointer;text-align:center;transition:all .2s ease;position:relative;
    }
    .pkg-pick:hover{border-color:rgba(64,207,255,.28);background:rgba(64,207,255,.06)}
    .pkg-pick.selected{border-color:rgba(64,207,255,.42);background:rgba(64,207,255,.10);box-shadow:0 0 0 1px rgba(64,207,255,.15)}
    .pkg-pick-cr{font-family:'Oswald',sans-serif;font-size:.80rem;font-weight:600;text-transform:uppercase;color:#fff;margin-bottom:3px}
    .pkg-pick-price{font-family:'Oswald',sans-serif;font-size:1.2rem;font-weight:700;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;margin-bottom:2px}
    .pkg-pick-cpp{font-size:.60rem;color:var(--muted);letter-spacing:.03em}
    .pkg-pick-badge{position:absolute;top:-8px;left:50%;transform:translateX(-50%);font-size:.55rem;font-weight:700;padding:2px 8px;border-radius:99px;background:var(--grad);color:#fff;white-space:nowrap;box-shadow:0 2px 8px rgba(240,64,200,.30)}
    .pkg-pick-summary{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      padding:14px 16px;border-radius:14px;
      background:linear-gradient(135deg,rgba(123,92,255,.09),rgba(240,64,200,.06));
      border:1px solid rgba(255,255,255,.09);margin-bottom:14px;
    }
    .rs-order-now-btn{
      width:100%;height:52px;border-radius:var(--r-md);border:none;cursor:pointer;
      background:var(--grad);color:#fff;
      font-family:'Oswald',sans-serif;font-size:.96rem;font-weight:700;
      letter-spacing:.07em;text-transform:uppercase;
      display:flex;align-items:center;justify-content:center;gap:10px;
      box-shadow:0 10px 32px rgba(123,92,255,.30);
      transition:all .28s ease;
    }
    .rs-order-now-btn:hover{transform:translateY(-2px);box-shadow:0 16px 44px rgba(240,64,200,.28);filter:brightness(1.06)}

    /* ── RESELLER MODAL (same as home) ── */
    .modal-overlay{display:none;position:fixed;inset:0;z-index:10000;background:rgba(4,6,18,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);align-items:center;justify-content:center;padding:14px}
    .modal-overlay.open{display:flex}
    .rs-modal{width:100%;max-width:520px;border-radius:26px;background:linear-gradient(160deg,#0E1128,#12103A);border:1px solid rgba(255,255,255,.10);box-shadow:0 40px 90px rgba(0,0,0,.60);overflow:hidden;max-height:92vh;overflow-y:auto}
    .rs-modal::-webkit-scrollbar{width:4px}.rs-modal::-webkit-scrollbar-thumb{background:rgba(255,255,255,.10);border-radius:4px}
    .rs-modal-head{padding:22px 22px 18px;background:linear-gradient(135deg,rgba(64,207,255,.12),rgba(123,92,255,.10));border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .rs-modal-icon{font-size:1.4rem;margin-bottom:5px}
    .rs-modal-title{font-family:'Oswald',sans-serif;font-size:1.3rem;font-weight:700;text-transform:uppercase;color:#fff}
    .rs-modal-pkg{display:inline-flex;align-items:center;padding:3px 12px;border-radius:var(--r-pill);background:var(--grad);color:#fff;font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin-top:7px}
    .rs-modal-close{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:var(--muted);cursor:pointer;display:grid;place-items:center;font-size:.85rem;flex-shrink:0;transition:all .2s;border:none}
    .rs-modal-close:hover{background:rgba(255,255,255,.12);color:#fff}
    .rs-modal-body{padding:20px}
    .rs-modal-form{display:flex;flex-direction:column;gap:12px}
    .rs-form-group{display:flex;flex-direction:column;gap:5px}
    .rs-form-label{font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
    .rs-form-input,.rs-form-select{width:100%;height:44px;padding:0 14px;border-radius:var(--r-md);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);color:#fff;font-family:'DM Sans',sans-serif;font-size:.88rem;outline:none;transition:all .22s ease;-webkit-appearance:none}
    .rs-form-input::placeholder{color:var(--muted)}
    .rs-form-input:-webkit-autofill,.rs-form-input:-webkit-autofill:focus{-webkit-box-shadow:0 0 0 1000px rgba(14,17,40,.95) inset!important;-webkit-text-fill-color:#fff!important}
    .rs-form-select option{color:#fff;background:#0E1128}
    .rs-form-input:focus,.rs-form-select:focus{border-color:rgba(64,207,255,.42);background:rgba(64,207,255,.06);box-shadow:0 0 0 3px rgba(64,207,255,.10)}
    .rs-form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .rs-pay-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr));gap:7px}
    .rs-pay-opt{padding:9px 6px;border-radius:9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;transition:all .2s}
    .rs-pay-opt:hover{border-color:rgba(64,207,255,.28);background:rgba(64,207,255,.06)}
    .rs-pay-opt.selected{border-color:rgba(64,207,255,.46);background:rgba(64,207,255,.10)}
    .rs-pay-ico{font-size:1.15rem}.rs-pay-lbl{font-size:.58rem;font-weight:600;letter-spacing:.04em;color:var(--muted);text-transform:uppercase;text-align:center}
    .rs-pay-opt.selected .rs-pay-lbl{color:var(--soft)}
    .rs-mprice{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:14px;background:linear-gradient(135deg,rgba(64,207,255,.09),rgba(123,92,255,.07));border:1px solid rgba(255,255,255,.09);gap:10px}
