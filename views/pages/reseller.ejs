        </div>
        <div class="rs-form-group">
          <label class="rs-form-label">Payment Method <span style="color:#f87171">*</span></label>
          <div class="rs-pay-grid">
            <div class="rs-pay-opt" onclick="rsSelectPay(this,'PayPal')"><div class="rs-pay-ico"><i class="fab fa-paypal"></i></div><div class="rs-pay-lbl">PayPal</div></div>
            <div class="rs-pay-opt" onclick="rsSelectPay(this,'Binance')"><div class="rs-pay-ico"><i class="fab fa-bitcoin"></i></div><div class="rs-pay-lbl">Binance</div></div>
            <div class="rs-pay-opt" onclick="rsSelectPay(this,'Cash Plus')"><div class="rs-pay-ico"><i class="fas fa-money-bill-wave"></i></div><div class="rs-pay-lbl">Cash Plus</div></div>
            <div class="rs-pay-opt" onclick="rsSelectPay(this,'Debit or Credit Card')"><div class="rs-pay-ico"><i class="fas fa-credit-card"></i></div><div class="rs-pay-lbl">Debit / Card</div></div>
            <div class="rs-pay-opt" onclick="rsSelectPay(this,'Bank Transfer')"><div class="rs-pay-ico"><i class="fas fa-building-columns"></i></div><div class="rs-pay-lbl">Bank Transfer</div></div>
          </div>
        </div>
        <div class="rs-mprice">
          <div>
            <div class="rs-mprice-label">Total Due</div>
            <div class="rs-mprice-pkg" id="rsMpricePkg">240 Credits — Reseller Panel</div>
          </div>
          <div><div class="rs-mprice-amt" id="rsMpriceAmt">€550</div></div>
        </div>
        <div>
          <div style="font-family:'Oswald',sans-serif;font-size:.68rem;font-weight:500;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-bottom:9px">
            How would you like to send your application?
          </div>
          <div class="rs-contact-grid">
            <button class="rs-contact-btn rs-contact-wa" onclick="rsSubmitOrder('whatsapp')">
