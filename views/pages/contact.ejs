<script>
/* ══ On page load: check if we arrived from another page (apps, home…)
     with a subject stored in sessionStorage → auto-scroll + pre-select ══ */
window.addEventListener('load', function(){
  try{
    var stored = sessionStorage.getItem('tivi_contact_subject');
    if(stored){
      sessionStorage.removeItem('tivi_contact_subject');
      setTimeout(function(){ scrollToForm(null, stored); }, 350);
    }
  }catch(err){}
});

/* ══ Navbar ══ */
function toggleNav(){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  var o=d.classList.toggle('open');h.classList.toggle('open',o);
}
function closeNav(){
  document.getElementById('nvDrawer').classList.remove('open');
  document.getElementById('nvHam').classList.remove('open');
}
document.addEventListener('click',function(e){
  var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
  if(d&&h&&!d.contains(e.target)&&!h.contains(e.target)){d.classList.remove('open');h.classList.remove('open');}
});


/* ══ CORE FUNCTION: scroll to form + pre-select subject + show banner ══ */
function scrollToForm(e, subject){
  if(e) e.preventDefault();

  // Pre-select the right subject button
  document.querySelectorAll('.subject-opt').forEach(function(o){ o.classList.remove('selected'); });
  document.querySelectorAll('.subject-opt').forEach(function(o){
    if(o.querySelector('.subject-opt-label').textContent.trim() === subject){
      o.classList.add('selected');
    }
  });
  document.getElementById('selectedSubject').value = subject;

  // Show intent banner with context message
  var msgs = {
    'Technical Support': '🔧 You selected Technical Support — fill the form and choose "Send via WhatsApp" for the fastest response.',
    'General Question':  '💬 You selected General Question — fill the form and send via WhatsApp or Email below.',
    'Subscription / Order': '🛒 You selected Subscription / Order — fill the form and our team will confirm your order instantly.',
    'Reseller Inquiry':  '🏪 You selected Reseller Inquiry — fill the form and we\'ll get back to you within minutes.'
  };
  var banner = document.getElementById('intentBanner');
  document.getElementById('intentText').textContent = msgs[subject] || msgs['General Question'];
  banner.classList.add('show');

  // Scroll smoothly to form
  var card = document.getElementById('contact-form');
  card.scrollIntoView({behavior:'smooth', block:'start'});

  // Flash highlight animation on the card
  setTimeout(function(){
    card.classList.remove('highlight');
    void card.offsetWidth; // reflow
    card.classList.add('highlight');
    setTimeout(function(){ card.classList.remove('highlight'); }, 1300);
  }, 400);

  // Focus first name field after scroll
  setTimeout(function(){
    var fn = document.getElementById('fName');
    if(fn) fn.focus();
  }, 800);
}

/* ══ Subject selector ══ */
function selectSubject(el, val){
  document.querySelectorAll('.subject-opt').forEach(function(o){ o.classList.remove('selected'); });
  el.classList.add('selected');
  document.getElementById('selectedSubject').value = val;
}

/* ══ Validator ══ */
function isEmail(s){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s); }

/* ══ Collect & validate ══ */
function collectAndValidate(){
  var name    = document.getElementById('fName').value.trim();
  var lname   = document.getElementById('lName').value.trim();
  var email   = document.getElementById('cEmail').value.trim();
  var phone   = document.getElementById('cPhone').value.trim();
  var country = document.getElementById('cCountry').value;
  var msg     = document.getElementById('cMessage').value.trim();
  var subject = document.getElementById('selectedSubject').value;

  ['fName','cEmail','cMessage'].forEach(function(id){
    document.getElementById(id).classList.remove('error');
    document.getElementById('err-'+id).classList.remove('show');
  });

  var ok=true;
  if(!name){document.getElementById('fName').classList.add('error');document.getElementById('err-fName').classList.add('show');ok=false;}
  if(!email||!isEmail(email)){document.getElementById('cEmail').classList.add('error');document.getElementById('err-cEmail').classList.add('show');ok=false;}
  if(!msg){document.getElementById('cMessage').classList.add('error');document.getElementById('err-cMessage').classList.add('show');ok=false;}
  if(!ok) return null;

  return {fullname:name+(lname?' '+lname:''),email:email,phone:phone,country:country,msg:msg,subject:subject};
}

/* ══ Submit ══ */
function submitContact(channel){
  var d=collectAndValidate();
  if(!d) return;

  var btnId  = channel==='whatsapp'?'btnWA':'btnEM';
  var spinId = channel==='whatsapp'?'spinWA':'spinEM';
  document.getElementById(btnId).classList.add('loading');
  document.getElementById(spinId).style.display='block';

  setTimeout(function(){
    if(channel==='whatsapp'){
      var lines=[
        '💬 *Contact — one4k Official*','',
        '📌 *Subject:* '+d.subject,
        '👤 *Name:* '+d.fullname,
        '📧 *Email:* '+d.email,
        (d.phone?'📱 *WhatsApp:* '+d.phone:''),
        (d.country?'🌍 *Country:* '+d.country:''),
        '','💬 *Message:*',d.msg,'',
        '─────────────────────',
        'Sent from one4k.app/contact'
      ].filter(function(l){return l!==''||true;}).join('\n');
      window.open('https://wa.me/447311129243?text='+encodeURIComponent(lines),'_blank');
    } else {
      var subj='[one4k] '+d.subject+' — '+d.fullname;
      var body=[
        'Hello one4k,','',
        '=== CONTACT FORM ===','',
        'Subject : '+d.subject,
        'Name    : '+d.fullname,
        'Email   : '+d.email,
        (d.phone?'WA/Tel  : '+d.phone:''),
        (d.country?'Country : '+d.country:''),
        '','--- Message ---',d.msg,'',
        '─────────────────────',
        'Sent from one4k.app/contact'
      ].join('\n');
      window.location.href='mailto:TVBillingTeam@gmail.com?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(body);
    }
    document.getElementById(btnId).classList.remove('loading');
    document.getElementById(spinId).style.display='none';
    document.getElementById('formBody').style.display='none';
    document.getElementById('formSuccess').classList.add('show');
  },800);
}

/* ══ Reset ══ */
function resetForm(){
  ['fName','lName','cEmail','cPhone','cMessage'].forEach(function(id){
    document.getElementById(id).value='';
    document.getElementById(id).classList.remove('error');
  });
  document.getElementById('cCountry').value='';
  document.querySelectorAll('.subject-opt').forEach(function(o,i){o.classList.toggle('selected',i===0);});
  document.getElementById('selectedSubject').value='General Question';
  ['err-fName','err-cEmail','err-cMessage'].forEach(function(id){document.getElementById(id).classList.remove('show');});
  document.getElementById('intentBanner').classList.remove('show');
  document.getElementById('formBody').style.display='block';
  document.getElementById('formSuccess').classList.remove('show');
}
</script>
