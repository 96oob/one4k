<script>
  /* ═══ AUTO YEAR ═══ */
  (function(){var y=new Date().getFullYear();document.querySelectorAll('.js-year').forEach(function(el){el.textContent=y;});})();

  /* ═══ NAVBAR ═══ */
  function toggleNav(){
    var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
    var o=d.classList.toggle('open');
    h.classList.toggle('open',o);
    h.setAttribute('aria-expanded',o?'true':'false');
    document.body.style.overflow=o?'hidden':'';
  }
  function closeNav(){
    var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
    if(d)d.classList.remove('open');if(h)h.classList.remove('open');
    if(h)h.setAttribute('aria-expanded','false');
    document.body.style.overflow='';
  }
  document.addEventListener('click',function(e){
    var d=document.getElementById('nvDrawer'),h=document.getElementById('nvHam');
    if(d&&h&&d.classList.contains('open')&&!d.contains(e.target)&&!h.contains(e.target)){closeNav();}
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeNav();closeTrialModal();}});

  /* ═══ FREE TRIAL MODAL ═══ */
  function openTrialModal(preferredChannel){
    var overlay=document.getElementById('trialModal');
    overlay.classList.add('open');
    document.body.style.overflow='hidden';
    var m=overlay.querySelector('.modal');if(m)m.scrollTop=0;
  }
  function closeTrialModal(){
    document.getElementById('trialModal').classList.remove('open');
    document.body.style.overflow='';
  }
  function closeTrialModalOutside(e){
    if(e.target===document.getElementById('trialModal')) closeTrialModal();
  }

  function submitTrial(channel){
    var name=document.getElementById('tName').value.trim()||'Not provided';
    var email=document.getElementById('tEmail').value.trim();
    var phone=document.getElementById('tPhone').value.trim();
    var country=document.getElementById('tCountry').value;
    var device=document.getElementById('tDevice').value||'All Devices';

    if(!email||!phone||!country){
      alert('Please fill in your Email, WhatsApp number and Country.');
      return;
    }

    // Send in background to Telegram & Google Sheets webhook
    try {
      fetch('/api/order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          plan: '24H Free Trial',
          amount: '€0',
          name: name,
          email: email,
          phone: phone,
          country: country,
          paymentMethod: 'Free Trial (' + device + ')',
          channel: channel,
          type: 'free_trial'
        })
      }).catch(function(err){ console.warn('Trial order log:', err); });
    } catch(e){}

    if(channel==='whatsapp'){
      var msg='🚀 *New one4k Free Trial Request*\n\n📺 *Request:* 24-Hour Free Trial (Channel List Test)\n💰 *Price:* €0 (100% Free)\n👤 *Name:* '+name+'\n📧 *Email:* '+email+'\n📱 *WhatsApp:* '+phone+'\n🌍 *Country:* '+country+'\n📱 *Device/App:* '+device;
      window.open('https://wa.me/447311129243?text='+encodeURIComponent(msg),'_blank');
    }else{
      var subj='one4k Free Trial Request — '+name+' ('+country+')';
      var body='New one4k Free Trial Request\n\nRequest: 24-Hour Free Trial\nPrice: €0 (Free)\nName: '+name+'\nEmail: '+email+'\nWhatsApp: '+phone+'\nCountry: '+country+'\nDevice: '+device;
      window.open('mailto:TVBillingTeam@gmail.com?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(body),'_blank');
    }

    closeTrialModal();
    alert('✅ Your Free Trial request has been received! Our team will send your test line credentials in under 2 minutes.');
  }
</script>
