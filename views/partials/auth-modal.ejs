<!-- ═══ ONE4K AUTH MODAL (REGISTER & LOGIN) ═══ -->
<div class="auth-modal-overlay" id="authModal" onclick="closeAuthModalOutside(event)" role="dialog" aria-modal="true" aria-label="Customer Account">
  <div class="auth-modal">
    
    <!-- Background Ambient Glow -->
    <div class="auth-modal-glow"></div>

    <!-- Header & Close -->
    <div class="auth-modal-header">
      <div class="auth-modal-brand">
        <div class="auth-modal-badge">Official IPTV Portal</div>
        <div class="auth-modal-title" id="authModalTitle">Welcome to <span class="text-grad">one4k</span></div>
      </div>
      <button class="auth-modal-close" onclick="closeAuthModal()" aria-label="Close dialog">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <!-- Mode Switcher Tabs -->
    <div class="auth-tabs">
      <button type="button" class="auth-tab-btn active" id="tabRegisterBtn" onclick="switchAuthTab('register')">
        <i class="fas fa-user-plus"></i> Create Account
      </button>
      <button type="button" class="auth-tab-btn" id="tabLoginBtn" onclick="switchAuthTab('login')">
        <i class="fas fa-sign-in-alt"></i> Sign In
      </button>
    </div>

    <!-- Alert Box -->
    <div id="authAlert" class="auth-alert" style="display: none;"></div>

    <!-- ══ REGISTER FORM ══ -->
    <form id="authRegisterForm" class="auth-form-body" onsubmit="submitAuthRegister(event)">
      <div class="auth-input-group">
        <label for="popupRegName">Full Name <span class="req-star">*</span></label>
        <div class="auth-input-wrapper">
          <i class="fas fa-user auth-icon"></i>
          <input type="text" id="popupRegName" required placeholder="e.g. John Doe" autocomplete="name">
        </div>
      </div>

      <div class="auth-input-group">
        <label for="popupRegPhone">WhatsApp Number <span class="req-star">*</span></label>
        <div class="auth-input-wrapper">
          <i class="fab fa-whatsapp auth-icon" style="color: #25d366;"></i>
          <input type="tel" id="popupRegPhone" required placeholder="+212 600 000 000" autocomplete="tel">
        </div>
      </div>

      <div class="auth-input-group">
        <label for="popupRegEmail">Email Address <span class="req-star">*</span></label>
        <div class="auth-input-wrapper">
          <i class="fas fa-envelope auth-icon"></i>
          <input type="email" id="popupRegEmail" required placeholder="your@email.com" autocomplete="email">
        </div>
      </div>

      <div class="auth-input-group">
        <label for="popupRegPass">Password <span class="req-star">*</span> <small style="color: var(--muted, #94a3b8);">(min. 6 chars)</small></label>
        <div class="auth-input-wrapper">
          <i class="fas fa-lock auth-icon"></i>
          <input type="password" id="popupRegPass" required minlength="6" placeholder="Choose a password" autocomplete="new-password">
          <button type="button" class="auth-pass-toggle" onclick="togglePassVisibility('popupRegPass', this)" aria-label="Toggle password visibility">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" id="popupRegSubmitBtn" class="auth-submit-btn auth-submit-register">
        <span>Create Account & Verify</span>
        <i class="fas fa-arrow-right"></i>
      </button>

      <div class="auth-footer-note">
        By registering, you agree to our Terms of Service & Privacy Policy.
      </div>
    </form>

    <!-- ══ LOGIN FORM ══ -->
    <form id="authLoginForm" class="auth-form-body" onsubmit="submitAuthLogin(event)" style="display: none;">
      <div class="auth-input-group">
        <label for="popupLoginEmail">Email Address <span class="req-star">*</span></label>
        <div class="auth-input-wrapper">
          <i class="fas fa-envelope auth-icon"></i>
          <input type="email" id="popupLoginEmail" required placeholder="your@email.com" autocomplete="email">
        </div>
      </div>

      <div class="auth-input-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
          <label for="popupLoginPass" style="margin: 0;">Password <span class="req-star">*</span></label>
          <a href="https://wa.me/447311129243?text=Hello,%20I%20forgot%20my%20one4k%20account%20password" target="_blank" class="auth-forgot-link">Forgot?</a>
        </div>
        <div class="auth-input-wrapper">
          <i class="fas fa-lock auth-icon"></i>
          <input type="password" id="popupLoginPass" required placeholder="Enter your password" autocomplete="current-password">
          <button type="button" class="auth-pass-toggle" onclick="togglePassVisibility('popupLoginPass', this)" aria-label="Toggle password visibility">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" id="popupLoginSubmitBtn" class="auth-submit-btn auth-submit-login">
        <span>Sign In to Account</span>
        <i class="fas fa-arrow-right"></i>
      </button>

      <div class="auth-footer-note">
        Need assistance? Contact our <a href="https://wa.me/447311129243" target="_blank" style="color: #25d366; text-decoration: none; font-weight: 600;"><i class="fab fa-whatsapp"></i> 24/7 VIP WhatsApp Support</a>.
      </div>
    </form>

  </div>
</div>

<style>
/* ═══ AUTH MODAL STYLES ═══ */
